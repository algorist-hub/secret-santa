@inherits LayoutComponentBase

@* Signed-out users (e.g. on Select Language or "page not found") see the screen without the main menu. *@
<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <div class="row app-shell">
                <aside class="col-12 col-md-3 col-xl-2 app-sidebar">
                    <div class="app-sidebar-inner">
                        <Brand />
                        <nav class="app-nav" aria-label="@L["Menu_AriaLabel"]">
                            <NavLink class="app-nav-item" href="@AppRoutes.Relative(AppRoutes.Home)">
                                <i class="bi bi-house-door" aria-hidden="true"></i><span>@L["Menu_Home"]</span>
                            </NavLink>
                            <NavLink class="app-nav-item" href="@AppRoutes.Relative(AppRoutes.Events)">
                                <i class="bi bi-calendar-event" aria-hidden="true"></i><span>@L["Menu_Events"]</span>
                            </NavLink>
                            <NavLink class="app-nav-item" href="@AppRoutes.Relative(AppRoutes.Friends)">
                                <i class="bi bi-people" aria-hidden="true"></i><span>@L["Menu_Friends"]</span>
                            </NavLink>
                            <NavLink class="app-nav-item app-nav-item-bottom" href="@AppRoutes.Relative(AppRoutes.Profile)">
                                <i class="bi bi-person-circle" aria-hidden="true"></i><span>@L["Menu_Profile"]</span>
                            </NavLink>
                        </nav>
                    </div>
                </aside>
                <main class="col app-content">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <AuthShell>@Body</AuthShell>
    </NotAuthorized>
</AuthorizeView>
