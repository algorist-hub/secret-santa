@page "/select-language"
@inject SelectLanguageViewModel Vm

<PageHeading TitleKey="SelectLanguage_Title" />

<div class="row">
    <div class="col-12 col-sm-10 col-md-9 col-lg-7 col-xl-5">
        <div class="app-card select-language-card">
            <fieldset>
                <legend class="visually-hidden">@L["SelectLanguage_Title"]</legend>
                @foreach (var language in Vm.Options)
                {
                    var id = $"language-{language.Code}";
                    <div class="form-check language-option">
                        <input class="form-check-input" type="radio" name="language" id="@id" value="@language.Code"
                               checked="@(Vm.SelectedCode == language.Code)"
                               @onchange="() => Vm.Select(language.Code)" />
                        <label class="form-check-label" for="@id">
                            <img class="language-flag" src="@language.FlagImagePath" alt="" />
                            <span>@L[language.NameKey]</span>
                        </label>
                    </div>
                }
            </fieldset>
            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-outline-secondary" id="cancel-language" @onclick="Vm.Cancel">
                    @L["Common_Cancel"]
                </button>
                <button type="button" class="btn btn-primary" id="apply-language" @onclick="Vm.ApplyAsync">
                    @L["Common_Apply"]
                </button>
            </div>
        </div>
    </div>
</div>
