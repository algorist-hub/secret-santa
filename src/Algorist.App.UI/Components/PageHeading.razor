@* Page title (h1) plus the browser tab title, both translated. *@

<PageTitle>@L[TitleKey] · @L["App_Title"]</PageTitle>
<h1 class="page-title h3 mb-3">@L[TitleKey]</h1>

@code {
    /// <summary>Resource key of the page title.</summary>
    [Parameter, EditorRequired]
    public string TitleKey { get; set; } = string.Empty;
}
